# Neon Postgres connection string (use pooled URL for serverless/Vercel)
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Optional: protect /api/cron/* (Vercel Cron sends Authorization: Bearer <CRON_SECRET>)
# CRON_SECRET=generate-a-long-random-string

# SMTP (required for employee "Request my records" email delivery)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com
